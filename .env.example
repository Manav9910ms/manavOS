NODE_ENV=production
PORT=3000
MANAVOS_DATA_DIR=./data
MANAVOS_WORKSPACES_DIR=./data/workspaces
MANAVOS_DISPLAY=:1
MANAVOS_BROWSER=chromium
# Vercel uses this to proxy /api/* requests to the persistent manavOS Node backend.
# Example: http://YOUR_EC2_PUBLIC_IP:3000
MANAVOS_BACKEND_URL=
AWS_REGION=ap-south-1
# Set this only when the control plane runs against a specific EC2 instance.
# AWS_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
